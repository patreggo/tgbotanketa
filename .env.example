# Токен от @BotFather
BOT_TOKEN=123456789:replace_me

# Числовой ID закрытой супергруппы, например -1001234567890
TARGET_CHAT_ID=-1001234567890

# Telegram ID администраторов через запятую. Узнать свой ID можно у @userinfobot.
ADMIN_IDS=123456789

# Путь к локальной базе. Папка data будет создана ботом автоматически.
DATABASE_PATH=data/applicants.sqlite3

